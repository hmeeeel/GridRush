# Supabase - Project Settings - API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...   # ТОЛЬКО на сервере, никогда не в клиент/репозиторий

# Необязательно: список разрешённых Origin через запятую ('*' - любой; пусто - только свой хост)
# ALLOWED_ORIGINS=https://my-game.onrender.com

# Необязательно: любые игровые константы (см. server/config.js)
# PORT=3000
# BOARD_W=16
# BOARD_H=12
# MOVE_COOLDOWN_MS=100
# MAX_PLAYERS=5
# MIN_SPAWN_DIST=5
# ITEM_TTL_MS=15000
# ROUND_DURATION_MS=180000
# IDLE_TIMEOUT_MS=120000
# AFK_REMOVE_MS=300000
# RECONNECT_GRACE_MS=20000
